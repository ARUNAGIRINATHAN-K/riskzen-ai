# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
POSTGRES_USER=riskzen
POSTGRES_PASSWORD=riskzen_dev
POSTGRES_DB=riskzen
DB_PORT=5432

# ──────────────────────────────────────────────
# Backend
# ──────────────────────────────────────────────
BACKEND_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# API key for MVP authentication
API_KEY=riskzen-dev-key

# Fernet encryption key for storing tokens at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ──────────────────────────────────────────────
# GitHub Integration
# ──────────────────────────────────────────────
# Personal Access Token with repo read access
GITHUB_TOKEN=

# ──────────────────────────────────────────────
# LLM Configuration
# ──────────────────────────────────────────────
# Provider: "ollama" (local, free) or "openai" (cloud, paid)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
OLLAMA_HOST=http://ollama:11434

# Only required if LLM_PROVIDER=openai
OPENAI_API_KEY=

# ──────────────────────────────────────────────
# Scheduler
# ──────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=60

# ──────────────────────────────────────────────
# Frontend
# ──────────────────────────────────────────────
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ──────────────────────────────────────────────
# Ollama
# ──────────────────────────────────────────────
OLLAMA_PORT=11434
